rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Advertisements collection
    match /advertisements/{adId} {
      // Anyone can read active ads
      allow read: if resource.data.isActive == true;

      // Only authenticated users can create ads
      allow create: if request.auth != null;

      // Only the ad owner can update/delete their ads
      allow update, delete: if request.auth != null &&
                              request.auth.uid == resource.data.sellerId;
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own data
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can write their own data
      allow write: if request.auth != null && request.auth.uid == userId;

      // Favorites subcollection
      match /favorites/{adId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Expenses collection
    match /expenses/{expenseId} {
      // Users can only read/write their own expenses
      allow read, write: if request.auth != null &&
                           request.auth.uid == resource.data.userId;
      allow create: if request.auth != null &&
                      request.auth.uid == request.resource.data.userId;
    }
  }
}